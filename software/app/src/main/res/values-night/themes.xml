<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ThermalEyes" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/theme_surface_dark</item>
        <item name="colorPrimaryVariant">@color/theme_bg_dark</item>
        <item name="colorOnPrimary">@color/theme_text_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/theme_accent_teal</item>
        <item name="colorSecondaryVariant">@color/theme_accent_teal</item>
        <item name="colorOnSecondary">@color/theme_bg_dark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/theme_bg_dark</item>
        <item name="android:navigationBarColor" tools:targetApi="o_mr1">@color/theme_bg_dark</item>
    </style>
</resources>